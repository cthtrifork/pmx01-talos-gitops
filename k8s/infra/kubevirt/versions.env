# Upstream release of the vendored operator manifests next to this file. Renovate bumps these; the
# "Update KubeVirt operators" workflow then regenerates the manifests on the PR branch
# (scripts/ci/update-kubevirt-operators.sh). Do not edit the *-operator.yaml files by hand.
# renovate: datasource=github-releases depName=kubevirt/kubevirt
KUBEVIRT_VERSION=v1.8.3
# renovate: datasource=github-releases depName=kubevirt/containerized-data-importer
CDI_VERSION=v1.66.1

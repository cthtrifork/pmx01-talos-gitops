{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:best-practices",
    "group:recommended"
  ],
  "suppressNotifications": [
    "prEditedNotification",
    "prIgnoreNotification"
  ],
  "rebaseWhen": "conflicted",
  // Renovate merges itself via the API (as the App, which bypasses main-protection) instead of
  // enabling GitHub native auto-merge, which does not honour the ruleset bypass.
  "platformAutomerge": false,
  // Rate limits, explicit instead of Renovate's defaults (2 PRs an hour, 10 open).
  "prHourlyLimit": 5,
  "prConcurrentLimit": 10,
  "recreateWhen": "always",
  "pinDigests": true,
  "semanticCommits": "enabled",
  "semanticCommitType": "deps",
  "semanticCommitScope": null,
  "commitMessageSuffix": "({{updateType}})",
  "ignorePaths": [
    "scripts/**",
    "k8s/**/rendered/**",
    "k8s/**/kyverno-policies/tests/**/*.yaml",
    "k8s/**/sync.yaml",
    "k8s/**/cluster.yaml"
  ],
  "docker-compose": {
    "managerFilePatterns": [
      "/(^|/)(?:docker-)?compose[^/]*\\.ya?ml$/"
    ]
  },
  "flux": {
    "managerFilePatterns": [
      "/(.+)\\.y(a?)ml/"
    ]
  },
  "github-actions": {
    "managerFilePatterns": [
      "/(^|/)(workflow-templates|\\.(?:github|gitea|forgejo)/(?:workflows|actions))/.+\\.ya?ml$/",
      "/(^|/)action\\.ya?ml$/"
    ]
  },
  "kubernetes": {
    "managerFilePatterns": [
      "/(.+)\\.y(a?)ml/"
    ]
  },
  "helm-values": {
    "managerFilePatterns": [
      "/(.+)\\.y(a?)ml/"
    ]
  },
  "helmfile": {
    "managerFilePatterns": [
      "/(.+)\\.y(a?)ml/"
    ]
  },
  "helmv3": {
    "managerFilePatterns": [
      "/(.+)\\.y(a?)ml/"
    ]
  },
  "packageRules": [
    {
      "description": "Automerge patch and digest updates everywhere; more specific rules below can override",
      "automerge": true,
      "automergeType": "pr",
      "matchUpdateTypes": [
        "patch",
        "digest"
      ]
    },
    {
      "automerge": false,
      "matchUpdateTypes": [
        "major",
        "minor"
      ],
      "matchPackageNames": [
        "/toolkit.fluxcd.io/",
        "/fluxcd/"
      ]
    },
    {
      "extends": [
        "helpers:pinGitHubActionDigests"
      ],
      "extractVersion": "^(?<version>v?\\d+\\.\\d+\\.\\d+)$",
      "versioning": "regex:^v?(?<major>\\d+)(\\.(?<minor>\\d+)\\.(?<patch>\\d+))?$",
      "recreateWhen": "always"
    },
    {
      "automerge": true,
      "pinDigests": false,
      "matchManagers": [
        "github-actions"
      ],
      "matchUpdateTypes": [
        "major",
        "minor",
        "patch"
      ]
    },
    {
      "matchDatasources": [
        "helm"
      ],
      "matchUpdateTypes": [
        "minor"
      ],
      "additionalBranchPrefix": "{{depName}}-",
      "matchPackageNames": [
        "*"
      ]
    },
    {
      "matchDatasources": [
        "helm",
        "docker"
      ],
      "matchPackageNames": [
        "cilium",
        "cilium/cilium",
        "quay.io/cilium/charts/cilium",
        "quay.io/cilium/cilium",
        "quay.io/cilium/operator",
        "quay.io/cilium/operator-generic",
        "quay.io/cilium/hubble-relay",
        "quay.io/cilium/hubble-ui",
        "quay.io/cilium/hubble-ui-backend"
      ],
      "groupName": "cilium",
      "groupSlug": "cilium",
      "automerge": false
    },
    {
      "description": "harper-pad-sync and harper-pad-admin are versioned together: the admin applies the schema, and a new sync pod is not ready until the matching admin has. One pull request moves both.",
      "matchDatasources": [
        "docker"
      ],
      "matchPackageNames": [
        "ghcr.io/cthtrifork/harper-pad-sync",
        "ghcr.io/cthtrifork/harper-pad-admin"
      ],
      "groupName": "harper-pad images",
      "groupSlug": "harper-pad-images"
    },
    {
      "description": "Renovate itself (the renovate_version pin and the renovatebot/github-action) automerges for every update type. Last, so it wins over the rules above.",
      "matchPackageNames": ["renovate", "renovatebot/github-action"],
      "automerge": true,
      "automergeType": "pr"
    }
  ],
  "customManagers": [
    {
      "customType": "regex",
      "description": "Catch image references with renovate comment",
      "managerFilePatterns": [
        "/.*\\.ya?ml$/"
      ],
      "matchStrings": [
        "# renovate: datasource=(?<datasource>\\S+) depName=(?<depName>\\S+)(?: versioning=(?<versioning>\\S+))?(?<indentation>\\s+)image:\\s+\"?(?<depName2>[^\\s:@\\\"]+)(?::(?<currentValue>[-a-zA-Z0-9.]+))?(?:@(?<currentDigest>sha256:[a-zA-Z0-9]+))?\"?"
      ],
      "autoReplaceStringTemplate": "# renovate: datasource={{{datasource}}} depName={{{depName}}}{{#if versioning}} versioning={{{versioning}}}{{/if}}{{{indentation}}}image: {{{depName}}}:{{{newValue}}}{{#if newDigest}}@{{{newDigest}}}{{/if}}"
    },
    {
      "customType": "regex",
      "description": "Catch imageName references (CloudNativePG cluster chart) with renovate comment",
      "managerFilePatterns": [
        "/.*\\.ya?ml$/"
      ],
      "matchStrings": [
        "# renovate: datasource=(?<datasource>\\S+) depName=(?<depName>\\S+)(?: versioning=(?<versioning>\\S+))?(?<indentation>\\s+)imageName:\\s+\"?(?<depName2>[^\\s:@\\\"]+)(?::(?<currentValue>[-a-zA-Z0-9.]+))?(?:@(?<currentDigest>sha256:[a-zA-Z0-9]+))?\"?"
      ],
      "autoReplaceStringTemplate": "# renovate: datasource={{{datasource}}} depName={{{depName}}}{{#if versioning}} versioning={{{versioning}}}{{/if}}{{{indentation}}}imageName: {{{depName}}}:{{{newValue}}}{{#if newDigest}}@{{{newDigest}}}{{/if}}"
    },
    {
      "customType": "regex",
      "description": "Catch image tags with renovate comment",
      "managerFilePatterns": [
        "/.*\\.ya?ml$/"
      ],
      "matchStrings": [
        "# renovate: datasource=(?<datasource>\\S+) depName=(?<depName>\\S+)(?: versioning=(?<versioning>\\S+))?(?<indentation>\\s+)tag:\\s+\"?(?<currentValue>[-a-zA-Z0-9.]+)?(?:@(?<currentDigest>sha256:[a-zA-Z0-9]+))?\"?"
      ],
      "autoReplaceStringTemplate": "# renovate: datasource={{{datasource}}} depName={{{depName}}}{{#if versioning}} versioning={{{versioning}}}{{/if}}{{{indentation}}}tag: {{{newValue}}}{{#if newDigest}}@{{{newDigest}}}{{/if}}"
    },
    {
      "customType": "regex",
      "managerFilePatterns": [
        "/^.github/.*\\.yaml$/"
      ],
      "matchStrings": [
        "(?<depName>[^\\s\"\\']+):\\s\"?(?<currentValue>.[^\"'\\s]*)\"?\\s+# renovate:\\s*datasource=(?<datasource>[^\\s]+)\\s+depName=(?<packageName>[^\\s]+)"
      ],
      "datasourceTemplate": "{{{datasource}}}",
      "packageNameTemplate": "{{{packageName}}}",
      "versioningTemplate": "semver"
    }
  ]
}

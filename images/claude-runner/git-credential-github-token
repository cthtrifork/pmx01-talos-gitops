#!/bin/sh
# git credential helper: answers "get" for github.com with the token in /etc/github/token.
[ "$1" = "get" ] || exit 0
host=""
while IFS='=' read -r key value; do
    [ -z "$key" ] && break
    [ "$key" = "host" ] && host="$value"
done
[ "$host" = "github.com" ] || exit 0
[ -r /etc/github/token ] || exit 0
printf 'username=x-access-token\npassword=%s\n' "$(cat /etc/github/token)"
